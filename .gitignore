# LaTeX generated files to ignore

# Auxiliary files generated by LaTeX and BibTeX
*.aux
*.bbl
*.blg
*.brf
*.lof
*.log
*.lot
*.toc
*.out
*.dvi
*.ent
*.fls
*.fdb_latexmk

# Index files
*.idx
*.ind
*.ilg

# Glossary files
*.glo
*.gls
*.glg

# Backup files created by some LaTeX editors
*~

# Other files
*.synctex.gz
*.nav
*.snm
*.vrb
*.acn
*.acr
*.alg
*.bcf
*.xml
*.snm
*.vrb
*.spl
*.soc
*.ist
*.run.xml

# Apple 
.DS_Store